<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================== -->
    <!-- كانبان: الشاشة الافتراضية للسلة -->
    <!-- ============================== -->
    <record id="view_product_template_trash_kanban" model="ir.ui.view">
        <field name="name">product.template.trash.kanban</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <kanban class="o_trash_kanban_view" create="false" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="default_code"/>
                <field name="deleted_at"/>
                <field name="days_remaining"/>
                <field name="image_128"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_trash_card">
                            <div class="o_trash_card_image">
                                <img t-att-src="kanban_image('product.template', 'image_128', record.id.raw_value)"
                                     alt="صورة المنتج"/>
                            </div>
                            <div class="o_trash_card_body">
                                <div class="o_trash_card_title">
                                    <field name="name"/>
                                </div>
                                <div class="o_trash_card_code text-muted"
                                     t-if="record.default_code.raw_value">
                                    الكود: <field name="default_code"/>
                                </div>
                                <div class="o_trash_card_date text-muted">
                                    اتحذف في: <field name="deleted_at" widget="date"/>
                                </div>

                                <div class="o_trash_progress">
                                    <div class="o_trash_progress_bar"
                                         t-attf-style="width: #{record.days_remaining.raw_value * 100 // 30}%"
                                         t-attf-class="#{record.days_remaining.raw_value &lt;= 7 and 'bg-danger' or (record.days_remaining.raw_value &lt;= 15 and 'bg-warning' or 'bg-success')}"/>
                                </div>

                                <div class="o_trash_card_footer">
                                    <span t-attf-class="badge rounded-pill #{record.days_remaining.raw_value &lt;= 7 and 'text-bg-danger' or (record.days_remaining.raw_value &lt;= 15 and 'text-bg-warning' or 'text-bg-success')}">
                                        <i class="fa fa-clock-o me-1"/>
                                        متبقي <t t-esc="record.days_remaining.raw_value"/> يوم
                                    </span>
                                    <button name="action_restore_from_trash" type="object"
                                            class="btn btn-sm btn-primary o_trash_restore_btn">
                                        <i class="fa fa-undo me-1"/> استرجاع
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================== -->
    <!-- ليست: عرض جدولي سريع -->
    <!-- ============================== -->
    <record id="view_product_template_trash_list" model="ir.ui.view">
        <field name="name">product.template.trash.list</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="سلة محذوفات المنتجات"
                  create="false" delete="false" edit="false"
                  decoration-danger="days_remaining &lt;= 7"
                  decoration-warning="days_remaining &gt; 7 and days_remaining &lt;= 15"
                  decoration-success="days_remaining &gt; 15">
                <field name="name" string="المنتج"/>
                <field name="default_code" string="الكود"/>
                <field name="deleted_at" string="تاريخ الحذف" widget="date"/>
                <field name="days_remaining" string="الأيام المتبقية"/>
                <button name="action_restore_from_trash" type="object"
                        string="استرجاع" icon="fa-undo" class="btn-link"/>
            </list>
        </field>
    </record>

    <!-- ============================== -->
    <!-- فورم: تفاصيل سجل واحد في السلة -->
    <!-- ============================== -->
    <record id="view_product_template_trash_form" model="ir.ui.view">
        <field name="name">product.template.trash.form</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <form string="سجل في السلة" create="false" edit="false">
                <header>
                    <button name="action_restore_from_trash" type="object"
                            string="استرجاع من السلة" class="btn-primary"/>
                </header>
                <sheet>
                    <field name="image_128" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="default_code" string="الكود"/>
                        </group>
                        <group>
                            <field name="deleted_at" string="تاريخ الحذف"/>
                            <field name="days_remaining" string="الأيام المتبقية قبل الحذف النهائي"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================== -->
    <!-- الأكشن: كانبان أولاً ثم ليست ثم فورم -->
    <!-- ============================== -->
    <record id="action_product_template_trash" model="ir.actions.act_window">
        <field name="name">سلة محذوفات المنتجات</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_trashed', '=', True)]</field>
        <field name="context">{'active_test': False}</field>
        <field name="help">
            <p class="o_view_nocontent_smiling_face">
                السلة فاضية دلوقتي 🎉
            </p>
            <p>
                أي منتج تحذفه هيظهر هنا لمدة 30 يوم، وتقدر تسترجعه في أي وقت
                قبل ما تنتهي المهلة.
            </p>
        </field>
    </record>

    <record id="action_product_template_trash_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_product_template_trash_kanban"/>
        <field name="act_window_id" ref="action_product_template_trash"/>
    </record>

    <record id="action_product_template_trash_view_list" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_product_template_trash_list"/>
        <field name="act_window_id" ref="action_product_template_trash"/>
    </record>

    <record id="action_product_template_trash_view_form" model="ir.actions.act_window.view">
        <field name="sequence">3</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_product_template_trash_form"/>
        <field name="act_window_id" ref="action_product_template_trash"/>
    </record>

    <!-- ============================== -->
    <!-- القوائم -->
    <!-- ============================== -->
    <menuitem id="menu_trash_root"
              name="سلة المحذوفات"
              sequence="100"/>

    <menuitem id="menu_product_template_trash"
              name="المنتجات"
              parent="menu_trash_root"
              action="action_product_template_trash"
              sequence="10"/>

</odoo>
